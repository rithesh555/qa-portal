{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "helpers:pinGitHubActionDigestsToSemver",
    "docker:pinDigests"
  ],
  "description": "Pinned versions only, never younger than 14 days (matches pnpm minimumReleaseAge). Review every PR; nothing automerges.",
  "timezone": "Asia/Kolkata",
  "schedule": ["before 9am on monday"],
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "rangeStrategy": "pin",
  "prConcurrentLimit": 5,
  "labels": ["dependencies"],
  "automerge": false,
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "minimumReleaseAge": null,
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "description": "Prisma is pinned on purpose; upgrade only after the user agrees.",
      "matchPackageNames": ["prisma", "@prisma/**"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Node stays on 22 LTS.",
      "matchDepNames": ["node", "@types/node"],
      "allowedVersions": "<23"
    },
    {
      "groupName": "eslint and prettier",
      "matchPackageNames": [
        "eslint",
        "@eslint/**",
        "eslint-*",
        "typescript-eslint",
        "prettier",
        "prettier-*"
      ]
    },
    {
      "groupName": "react",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ]
    },
    {
      "groupName": "fastify",
      "matchPackageNames": ["fastify", "@fastify/**", "fastify-*"]
    },
    {
      "groupName": "playwright",
      "matchPackageNames": [
        "@playwright/test",
        "playwright",
        "@axe-core/playwright"
      ]
    },
    {
      "groupName": "commit tooling",
      "matchPackageNames": ["@commitlint/**", "lefthook"]
    },
    {
      "groupName": "github actions",
      "matchManagers": ["github-actions"]
    },
    {
      "description": "Major upgrades wait for a tick on the Dependency Dashboard: they can need migration work (a Postgres major needs a dump and restore).",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Overrides in pnpm-workspace.yaml pin one major line each (e.g. undici@^7); never move them to the next major.",
      "matchFileNames": ["pnpm-workspace.yaml"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "engines.node is a supported range, not a pin.",
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "description": "lefthook 2.2.2 was published without provenance (pnpm trustPolicy rejects it); see docs/devops/stage-02-ci.md.",
      "matchPackageNames": ["lefthook"],
      "allowedVersions": "!/^2\\.2\\.2$/"
    },
    {
      "description": "One Node version everywhere: Docker base image, CI and .nvmrc move together.",
      "matchDepNames": ["node"],
      "groupName": "node"
    },
    {
      "description": "pnpm in package.json (packageManager) and the Dockerfile move together.",
      "matchDepNames": ["pnpm"],
      "groupName": "pnpm"
    },
    {
      "description": "Tool images that CI and the git hooks run with docker run.",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["docker"],
      "groupName": "ci tool images"
    },
    {
      "description": "OpenTofu reads providers from registry.opentofu.org (see .terraform.lock.hcl), so Renovate looks there too.",
      "matchDatasources": ["terraform-provider", "terraform-module"],
      "registryUrls": ["https://registry.opentofu.org"]
    },
    {
      "description": "Local platform tooling under infra/ (laptop CLI pins, the k3s node image, providers, the Argo CD chart) in one PR. CI lint images live in ci.yml and stay in the ci tool images group.",
      "matchFileNames": ["infra/**"],
      "groupName": "local platform"
    },
    {
      "description": "The Argo CD chart and the images its values pin by digest move together (the image tag is the chart's appVersion).",
      "matchFileNames": ["infra/local/platform/**"],
      "matchDepNames": [
        "argo-cd",
        "quay.io/argoproj/argocd",
        "ecr-public.aws.com/docker/library/redis"
      ],
      "groupName": "argo cd"
    },
    {
      "description": "k3s tags look like v1.36.5-k3s1. Stay on Kubernetes 1.36 until the pinned Argo CD is tested on a newer minor (docs/devops/stage-04-k8s-platform.md). A k3s bump rebuilds the cluster: back up first.",
      "matchDepNames": ["rancher/k3s"],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-k3s(?<build>\\d+)$",
      "allowedVersions": "/^v1\\.36\\./"
    },
    {
      "description": "required_version is an OpenTofu range, but Renovate would look it up as Terraform. Bump it by hand with the OpenTofu version.",
      "matchManagers": ["terraform"],
      "matchDepTypes": ["required_version"],
      "enabled": false
    },
    {
      "description": "The OpenTofu CLI pin (cluster.sh) and the CI image move together.",
      "matchDepNames": ["opentofu/opentofu", "ghcr.io/opentofu/opentofu"],
      "groupName": "opentofu"
    },
    {
      "description": "Platform add-ons Argo CD installs (deploy/argocd/platform charts, deploy/platform values and manifests): each chart moves with the image pins in its values file. Read the chart's upgrade notes first (CRD changes, Kyverno policy API).",
      "matchFileNames": ["deploy/argocd/platform/**", "deploy/platform/**"],
      "groupName": "platform add-ons"
    },
    {
      "description": "KSOPS runs inside the Argo CD repo server (infra/local/platform/argocd-values.yaml).",
      "matchDepNames": ["viaductoss/ksops"],
      "groupName": "argo cd"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool images run with `docker run` in workflows and lefthook.yml",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/",
        "/^lefthook\\.yml$/"
      ],
      "matchStrings": [
        "(?<depName>(?:ghcr\\.io/zizmorcore/zizmor|ghcr\\.io/gitleaks/gitleaks|hadolint/hadolint|koalaman/shellcheck|aquasec/trivy|rhysd/actionlint|semgrep/semgrep|anchore/syft|mikefarah/yq|ghcr\\.io/opentofu/opentofu|ghcr\\.io/terraform-linters/tflint|ghcr\\.io/yannh/kubeconform)):(?<currentValue>v?[0-9][\\w.-]*)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "pnpm version the Dockerfile activates with corepack",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": ["corepack prepare pnpm@(?<currentValue>[0-9][\\w.-]*)"],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Default Node version of the CI setup action",
      "managerFilePatterns": ["/^\\.github/actions/setup/action\\.yml$/"],
      "matchStrings": [
        "node-version:\\s*\\n\\s*description:[^\\n]*\\n\\s*default:\\s*\"(?<currentValue>[0-9][\\w.-]*)\""
      ],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version",
      "versioningTemplate": "node"
    },
    {
      "customType": "regex",
      "description": "Tool versions with a `# renovate:` comment on the line above (infra/local/cluster.sh)",
      "managerFilePatterns": ["/^infra/local/cluster\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[\\w-]+) depName=(?<depName>[\\w./-]+)\\n\\w+=(?<currentValue>[0-9][\\w.-]*)"
      ],
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "k3s node image in the k3d cluster config",
      "managerFilePatterns": ["/^infra/local/k3d\\.yaml$/"],
      "matchStrings": [
        "image: (?<depName>rancher/k3s):(?<currentValue>v[\\w.-]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Plain image strings (image: repo:tag@digest) in the Argo CD values (the KSOPS init container)",
      "managerFilePatterns": ["/^infra/local/platform/argocd-values\\.yaml$/"],
      "matchStrings": [
        "image: (?<depName>[\\w./-]+):(?<currentValue>v?[0-9][\\w.-]*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Helm CLI that CI downloads and checks against its published SHA-256 (ci.yml infra job). Renovate bumps the version; refresh HELM_SHA256 by hand from the release notes.",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": ["HELM_VERSION: (?<currentValue>v[0-9][\\w.-]*)"],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases"
    }
  ],
  "helm-values": {
    "managerFilePatterns": [
      "/^infra/local/platform/argocd-values\\.yaml$/",
      "/^deploy/platform/.+values\\.yaml$/"
    ]
  },
  "argocd": {
    "managerFilePatterns": ["/^deploy/argocd/.+\\.yaml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^deploy/platform/.+\\.yaml$/"]
  }
}
