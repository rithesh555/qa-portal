# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL (compose.yaml) ---
POSTGRES_USER=qa_portal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=qa_portal
POSTGRES_TEST_DB=qa_portal_test
# 5433: a native Windows PostgreSQL may already hold 5432
POSTGRES_PORT=5433

# --- API ---
# Required: development | test | production. Production: JSON logs, no API
# docs, https-only WEB_ORIGIN/BETTER_AUTH_URL (localhost excepted).
# db:seed:demo runs only in development and only against a local database.
NODE_ENV=development
DATABASE_URL=postgresql://qa_portal:change-me@localhost:5433/qa_portal
TEST_DATABASE_URL=postgresql://qa_portal:change-me@localhost:5433/qa_portal_test
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info
# Proxies whose X-Forwarded-For is trusted for the client IP (Fastify trustProxy).
# Must match your real proxy (dev: the Vite proxy on loopback; behind nginx in
# Docker, its address or CIDR). If it's wrong, every client looks like the
# proxy and they all share one per-IP sign-in budget (30/min).
TRUST_PROXY=127.0.0.1
# Public URL of the web app (CORS, Better Auth trusted origin, and the only
# origin allowed to send write requests)
WEB_ORIGIN=http://localhost:5173

# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Seed admin (used by `pnpm db:seed`) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@qa-portal.local
SEED_ADMIN_PASSWORD=

# --- Demo data (used by `pnpm db:seed:demo`, development only) ---
# Shared password for every demo account (demo.admin, demo.lead, ...).
DEMO_USER_PASSWORD=
