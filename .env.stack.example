# Values for docker/compose.stack.yaml. `docker/stack.sh init` writes a real
# .env.stack with random secrets; this file only lists the names.
POSTGRES_USER=qa_portal
POSTGRES_PASSWORD=
POSTGRES_DB=qa_portal
# openssl rand -base64 32
BETTER_AUTH_SECRET=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=admin@qa-portal.local
# at least 12 characters
SEED_ADMIN_PASSWORD=
