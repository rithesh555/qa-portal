generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

// Auth models below were generated by `pnpm auth:generate` (Better Auth CLI),
// then given snake_case @map/@@map names and timestamptz columns.
// Better Auth addresses Prisma model/field names, so the mappings are safe.
// If you regenerate after adding a Better Auth plugin, re-apply them.

datasource db {
  provider = "postgresql"
}

model User {
  id              String        @id
  name            String
  email           String
  emailVerified   Boolean       @default(false) @map("email_verified")
  image           String?
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  username        String?
  displayUsername String?       @map("display_username")
  role            String?
  banned          Boolean?      @default(false)
  banReason       String?       @map("ban_reason")
  banExpires      DateTime?     @map("ban_expires") @db.Timestamptz(3)
  sessions        Session[]
  accounts        Account[]
  activities      ActivityLog[]

  @@unique([email])
  @@unique([username])
  @@map("users")
}

model Session {
  id             String   @id
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  token          String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?  @map("impersonated_by")

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt @map("last_request")

  @@unique([key])
  @@map("rate_limits")
}

// ---------------------------------------------------------------------------
// Portal models (hand-written). Conventions: uuid(7) ids, snake_case names,
// timestamptz, an index on every foreign key.
// ---------------------------------------------------------------------------

/// Append-only record of every change, written in the same transaction as the
/// change where possible. Feeds entity history and the dashboard.
model ActivityLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String   @map("actor_id")
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  /// Null for portal-wide changes (e.g. user management). FK added with projects.
  projectId  String?  @map("project_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  /// Changed fields as { field: { from, to } }; never contains secrets.
  changes    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@map("activity_log")
}
