generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

// Auth models below were generated by `pnpm auth:generate` (Better Auth CLI),
// then given snake_case @map/@@map names and timestamptz columns.
// Better Auth addresses Prisma model/field names, so the mappings are safe.
// If you regenerate after adding a Better Auth plugin, re-apply them.

datasource db {
  provider = "postgresql"
}

model User {
  id              String          @id
  name            String
  email           String
  emailVerified   Boolean         @default(false) @map("email_verified")
  image           String?
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  username        String?
  displayUsername String?         @map("display_username")
  role            String?
  banned          Boolean?        @default(false)
  banReason       String?         @map("ban_reason")
  banExpires      DateTime?       @map("ban_expires") @db.Timestamptz(3)
  sessions        Session[]
  accounts        Account[]
  activities      ActivityLog[]
  memberships     ProjectMember[] @relation("member")
  addedMembers    ProjectMember[] @relation("addedBy")
  createdProjects Project[]
  createdReleases Release[]
  createdSuites   Suite[]
  createdCases    TestCase[]      @relation("caseCreatedBy")
  updatedCases    TestCase[]      @relation("caseUpdatedBy")
  importBatches   ImportBatch[]
  createdRuns     TestRun[]       @relation("runCreatedBy")
  closedRuns      TestRun[]       @relation("runClosedBy")
  assignedCases   RunCase[]
  recordedResults TestResult[]

  @@unique([email])
  @@unique([username])
  @@map("users")
}

model Session {
  id             String   @id
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  token          String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?  @map("impersonated_by")

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt @map("last_request")

  @@unique([key])
  @@map("rate_limits")
}

// ---------------------------------------------------------------------------
// Portal models (hand-written). Conventions: uuid(7) ids, snake_case names,
// timestamptz, an index on every foreign key.
// ---------------------------------------------------------------------------

/// Append-only record of every change, written in the same transaction as the
/// change where possible. Feeds entity history and the dashboard.
model ActivityLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  actorId    String   @map("actor_id")
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  /// Null for portal-wide changes (e.g. user management).
  projectId  String?  @map("project_id") @db.Uuid
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  /// Changed fields as { field: { from, to } }; never contains secrets.
  changes    Json?
  /// False for the per-item entries of a bulk change or import: the project
  /// feed shows that change's summary entry instead.
  inFeed     Boolean  @default(true) @map("in_feed")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([actorId, createdAt(sort: Desc)])
  @@index([projectId, inFeed, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@map("activity_log")
}

enum ProjectRole {
  lead
  tester
  viewer

  @@map("project_role")
}

enum ReleaseStatus {
  planned
  in_progress
  released

  @@map("release_status")
}

/// Projects are archived, never deleted.
model Project {
  id          String           @id @default(uuid(7)) @db.Uuid
  /// 2–6 capitals/digits; part of every ID (PAY-TC-12), so never changes.
  key         String           @unique
  name        String
  description String           @default("")
  archivedAt  DateTime?        @map("archived_at") @db.Timestamptz(3)
  createdById String           @map("created_by_id")
  createdBy   User             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  /// Optimistic concurrency: bumped on every edit.
  version     Int              @default(1)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  members     ProjectMember[]
  releases    Release[]
  activities  ActivityLog[]
  counters    ProjectCounter[]
  suites      Suite[]
  cases       TestCase[]
  imports     ImportBatch[]
  runs        TestRun[]

  @@index([createdById])
  @@index([archivedAt, name])
  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(uuid(7)) @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  userId    String      @map("user_id")
  user      User        @relation("member", fields: [userId], references: [id], onDelete: Restrict)
  role      ProjectRole
  addedById String      @map("added_by_id")
  addedBy   User        @relation("addedBy", fields: [addedById], references: [id], onDelete: Restrict)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([addedById])
  @@index([projectId, role])
  @@map("project_members")
}

model Release {
  id          String        @id @default(uuid(7)) @db.Uuid
  projectId   String        @map("project_id") @db.Uuid
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name        String
  description String        @default("")
  status      ReleaseStatus @default(planned)
  startDate   DateTime?     @map("start_date") @db.Date
  targetDate  DateTime?     @map("target_date") @db.Date
  createdById String        @map("created_by_id")
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  version     Int           @default(1)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  runs TestRun[]

  @@unique([projectId, name])
  @@index([projectId, status])
  @@index([createdById])
  @@map("releases")
}

/// Per-project sequences for readable IDs (PAY-TC-12, import #7, later runs
/// and defects). Allocated with INSERT … ON CONFLICT … RETURNING inside the
/// write's transaction, so numbers are never reused.
model ProjectCounter {
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  /// "case", "import", …
  scope     String
  /// The last number handed out.
  value     Int     @default(0)

  @@id([projectId, scope])
  @@map("project_counters")
}

/// Groups test cases. One level of nesting (a parent must be top-level), checked
/// in the service so it can be lifted later. Sibling names are unique among
/// active suites, ignoring case — also checked in the service, under the
/// project lock that every suite write takes.
model Suite {
  id            String       @id @default(uuid(7)) @db.Uuid
  projectId     String       @map("project_id") @db.Uuid
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  parentId      String?      @map("parent_id") @db.Uuid
  parent        Suite?       @relation("suiteChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children      Suite[]      @relation("suiteChildren")
  name          String
  archivedAt    DateTime?    @map("archived_at") @db.Timestamptz(3)
  /// Set when an import created this suite, so archiving the import can tidy it up.
  importBatchId String?      @map("import_batch_id") @db.Uuid
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  createdById   String       @map("created_by_id")
  createdBy     User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  version       Int          @default(1)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  cases         TestCase[]   @relation("caseSuite")
  archivedCases TestCase[]   @relation("caseArchivedWithSuite")

  @@index([projectId, archivedAt])
  @@index([parentId])
  @@index([importBatchId])
  @@index([createdById])
  @@map("suites")
}

enum CasePriority {
  critical
  high
  medium
  low

  @@map("case_priority")
}

enum CaseType {
  functional
  security
  performance
  usability
  other

  @@map("case_type")
}

enum CaseStatus {
  draft
  ready

  @@map("case_status")
}

/// Test cases are archived, never deleted. Test runs (Phase 5) copy a case's
/// content when it is added, so editing never rewrites past results.
model TestCase {
  id               String       @id @default(uuid(7)) @db.Uuid
  projectId        String       @map("project_id") @db.Uuid
  project          Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  /// Per project, from ProjectCounter scope "case": the 12 in PAY-TC-12.
  number           Int
  suiteId          String?      @map("suite_id") @db.Uuid
  suite            Suite?       @relation("caseSuite", fields: [suiteId], references: [id], onDelete: Restrict)
  title            String
  preconditions    String       @default("")
  /// [{ action, expected }] in order; always replaced as a whole with the case.
  steps            Json
  priority         CasePriority
  type             CaseType
  status           CaseStatus   @default(draft)
  labels           String[]     @default([])
  references       String       @default("")
  archivedAt       DateTime?    @map("archived_at") @db.Timestamptz(3)
  archiveReason    String       @default("") @map("archive_reason")
  /// The suite whose archiving archived this case; restoring the case restores it.
  archivedSuiteId  String?      @map("archived_suite_id") @db.Uuid
  archivedSuite    Suite?       @relation("caseArchivedWithSuite", fields: [archivedSuiteId], references: [id], onDelete: Restrict)
  importBatchId    String?      @map("import_batch_id") @db.Uuid
  importBatch      ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  duplicatedFromId String?      @map("duplicated_from_id") @db.Uuid
  duplicatedFrom   TestCase?    @relation("caseDuplicates", fields: [duplicatedFromId], references: [id], onDelete: Restrict)
  duplicates       TestCase[]   @relation("caseDuplicates")
  runCases         RunCase[]
  /// Shown as "version": bumped only when the title, preconditions or steps change.
  revision         Int          @default(1)
  /// Optimistic concurrency: bumped on every change.
  version          Int          @default(1)
  createdById      String       @map("created_by_id")
  createdBy        User         @relation("caseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById      String       @map("updated_by_id")
  updatedBy        User         @relation("caseUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([projectId, number])
  @@index([projectId, archivedAt, suiteId])
  @@index([projectId, updatedAt])
  @@index([suiteId])
  @@index([archivedSuiteId])
  @@index([importBatchId])
  @@index([duplicatedFromId])
  @@index([createdById])
  @@index([updatedById])
  @@index([labels], type: Gin)
  @@map("test_cases")
}

/// One CSV/Excel import, so a lead can archive everything it added at once.
model ImportBatch {
  id          String     @id @default(uuid(7)) @db.Uuid
  projectId   String     @map("project_id") @db.Uuid
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  /// Per project, from ProjectCounter scope "import": import #7.
  number      Int
  fileName    String     @map("file_name")
  caseCount   Int        @map("case_count")
  archivedAt  DateTime?  @map("archived_at") @db.Timestamptz(3)
  createdById String     @map("created_by_id")
  createdBy   User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  cases       TestCase[]
  suites      Suite[]

  @@unique([projectId, number])
  @@index([createdById])
  @@map("import_batches")
}

enum RunState {
  open
  closed

  @@map("run_state")
}

enum RunCaseStatus {
  passed
  failed
  blocked
  skipped
  untested

  @@map("run_case_status")
}

/// A test run: a fixed set of copied test cases, each getting results.
/// Closed runs are read-only; only a QA Lead reopens them.
model TestRun {
  id          String    @id @default(uuid(7)) @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  /// Per project, from ProjectCounter scope "run": the 12 in PAY-R-12.
  number      Int
  name        String
  description String    @default("")
  /// Free text such as "Chrome 128 · build 4.2.0-rc1".
  environment String    @default("")
  releaseId   String?   @map("release_id") @db.Uuid
  release     Release?  @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  state       RunState  @default(open)
  closedAt    DateTime? @map("closed_at") @db.Timestamptz(3)
  closedById  String?   @map("closed_by_id")
  closedBy    User?     @relation("runClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  createdById String    @map("created_by_id")
  createdBy   User      @relation("runCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  cases       RunCase[]

  @@unique([projectId, number])
  @@index([projectId, state, updatedAt(sort: Desc)])
  @@index([releaseId])
  @@index([createdById])
  @@index([closedById])
  @@map("test_runs")
}

/// One test case inside a run, with the copy (snapshot) the run took of it.
/// `status` mirrors the latest result so lists and counts need no joins.
model RunCase {
  id            String        @id @default(uuid(7)) @db.Uuid
  runId         String        @map("run_id") @db.Uuid
  run           TestRun       @relation(fields: [runId], references: [id], onDelete: Restrict)
  /// The source case; kept even if it is archived later.
  caseId        String        @map("case_id") @db.Uuid
  case          TestCase      @relation(fields: [caseId], references: [id], onDelete: Restrict)
  /// Suite order, then case number, when the case was added.
  position      Int
  // --- snapshot of the case -----------------------------------------------
  title         String
  preconditions String        @default("")
  steps         Json
  suitePath     String        @default("") @map("suite_path")
  priority      CasePriority
  type          CaseType
  caseStatus    CaseStatus    @map("case_status")
  labels        String[]      @default([])
  /// The case's version (revision) that was copied.
  revision      Int
  // ---------------------------------------------------------------------------
  assigneeId    String?       @map("assignee_id")
  assignee      User?         @relation(fields: [assigneeId], references: [id], onDelete: Restrict)
  status        RunCaseStatus @default(untested)
  /// Bumped on every result, re-copy or assignment: concurrent recording check.
  version       Int           @default(1)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  results       TestResult[]

  @@unique([runId, caseId])
  @@index([runId, position])
  @@index([runId, status])
  @@index([caseId])
  @@index([assigneeId])
  @@map("run_cases")
}

/// A recorded result. Never edited or deleted: a newer result supersedes it
/// (undo and "use the latest version" add an "untested" result).
model TestResult {
  id           String        @id @default(uuid(7)) @db.Uuid
  runCaseId    String        @map("run_case_id") @db.Uuid
  runCase      RunCase       @relation(fields: [runCaseId], references: [id], onDelete: Restrict)
  status       RunCaseStatus
  note         String        @default("")
  failedStep   Int?          @map("failed_step")
  /// The case version this result was recorded against.
  revision     Int
  recordedById String        @map("recorded_by_id")
  recordedBy   User          @relation(fields: [recordedById], references: [id], onDelete: Restrict)
  recordedAt   DateTime      @default(now()) @map("recorded_at") @db.Timestamptz(3)

  @@index([runCaseId, recordedAt(sort: Desc)])
  @@index([recordedById])
  @@map("test_results")
}
