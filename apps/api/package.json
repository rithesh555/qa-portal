{
  "name": "@qa/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:demo": "node prisma/seed-demo.ts",
    "db:studio": "prisma studio",
    "auth:generate": "auth generate --config src/auth/cli-config.ts --output prisma/schema.prisma",
    "postinstall": "prisma generate",
    "db:seed:stress": "node prisma/seed-stress.ts",
    "db:seed:e2e": "node prisma/seed-e2e.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.1.2",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@qa/shared": "workspace:*",
    "better-auth": "1.7.7",
    "fastify": "5.12.5",
    "fastify-plugin": "6.0.0",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "dotenv": "18.0.7",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.0",
    "vitest": "5.0.3"
  }
}
